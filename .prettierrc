{
	"useTabs": true,
	"singleQuote": true,
	"semi": true,
	"tabWidth": 2,
	"trailingComma": "none",
	"arrowParens": "always",
	"quoteProps": "as-needed",
	"embeddedLanguageFormatting": "auto",
	"bracketSpacing": true,
	"bracketSameLine": false,
	"printWidth": 80,
	"plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
	"overrides": [
		{
			"files": "**/*.svelte",
			"options": {
				"parser": "svelte"
			}
		}
	]
}
